{
  "name": "ghost-virtuals-agent",
  "version": "0.5.0",
  "private": true,
  "description": "GhOsT Base meme research, simulation and self-hosted Uniswap v3 live execution",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/xx10gboyxx-source/ghost-virtuals-agent.git"
  },
  "keywords": [
    "ai-agent",
    "virtuals-protocol",
    "base",
    "meme-coins",
    "paper-trading",
    "risk-screening",
    "live-trading"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "demo": "node examples/demo.mjs",
    "status": "node operator.mjs status",
    "report": "node agent/cli.mjs",
    "agent": "node agent/task.mjs",
    "agent:demo": "node agent/task.mjs --demo",
    "evaluate": "node agent/task.mjs --evaluate && node examples/evaluate-meme.mjs",
    "check:public": "node scripts/check-public.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "readiness": "node scripts/readiness.mjs",
    "start": "node agent/run.mjs run",
    "agent:once": "node agent/run.mjs once",
    "agent:status": "node agent/run.mjs status",
    "agent:reports": "node agent/run.mjs reports",
    "agent:pause": "node agent/run.mjs pause",
    "agent:resume": "node agent/run.mjs resume",
    "runtime:demo": "node examples/runtime-demo.mjs",
    "live": "node live/run.mjs"
  },
  "dependencies": {
    "viem": "2.57.7"
  }
}
