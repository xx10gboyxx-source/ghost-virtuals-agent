# Optional: npm start works with no environment variables.
# Default token watchlist: verified TOSHI Base contract. Maximum two addresses.
# Set TOKENS or POOLS, never both. Export values in the process environment;
# this project does not load .env files automatically.
GHOST_BASE_TOKENS=
GHOST_BASE_POOLS=
GHOST_STRATEGY=volume-breakout
GHOST_STATE_PATH=./state/ghost-agent.sqlite
# Optional separate research explanation commands only; not used by npm start.
GHOST_ENABLE_INFERENCE=false
VIRTUALS_API_KEY=
VIRTUALS_MODEL=
