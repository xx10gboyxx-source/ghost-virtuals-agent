# User-service template, not an installed deployment.
[Unit]
Description=GhOsT Base meme research ACP worker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/ghost-virtuals-agent
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node agent/acp-cli.mjs run %h/.config/ghost-acp/worker.json
Restart=on-failure
RestartSec=30
TimeoutStopSec=75
KillMode=control-group
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
